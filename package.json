{
  "name": "queuetie-monorepo",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "remote:gateway": "nest start gateway --debug 0.0.0.0:9229 --watch",
    "remote:dispatcher": "nest start dispatcher --debug 0.0.0.0:9229 --watch",
    "remote:worker": "nest start worker --debug 0.0.0.0:9229 --watch",
    "start:prod": "node dist/apps/queuetie-monorepo/main",
    "start:dashboard": "vite --config vite.config.ts",
    "build:dashboard": "vite build --config vite.config.ts",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:jest": "jest",
    "test:dashboard": "vitest run --config apps/dashboard/vitest.config.ts",
    "test:dashboard:ui": "vitest --config apps/dashboard/vitest.config.ts --ui",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./apps/queuetie-monorepo/test/jest-e2e.json",
    "test:storybook": "test-storybook",
    "test:storybook:dev": "start-server-and-test storybook http://127.0.0.1:6006 test:storybook",
    "prepare": "husky",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@faker-js/faker": "^9.9.0",
    "@mui/icons-material": "^7.2.0",
    "@mui/material": "^7.2.0",
    "@nestjs/bullmq": "^11.0.1",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.1",
    "@nestjs/event-emitter": "^3.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/platform-socket.io": "^11.0.6",
    "@nestjs/swagger": "^11.0.3",
    "@nestjs/websockets": "^11.0.6",
    "@tanstack/react-query": "^5.84.1",
    "@types/jest": "^29.5.14",
    "axios": "^1.11.0",
    "bullmq": "^5.39.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "date-fns": "^4.1.0",
    "husky": "^9.1.7",
    "ioredis": "^5.7.0",
    "nestjs-pino": "^4.3.0",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "pino-pretty": "^13.0.0",
    "pretty-quick": "^4.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^4.1.0",
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.6",
    "@storybook/addon-a11y": "^9.1.2",
    "@storybook/addon-docs": "^9.1.2",
    "@storybook/addon-vitest": "^9.1.2",
    "@storybook/react-vite": "^9.1.2",
    "@storybook/test-runner": "^0.23.0",
    "@swc/cli": "^0.6.0",
    "@swc/core": "^1.10.7",
    "@testing-library/jest-dom": "^6.6.3",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.7",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.6.0",
    "@vitest/browser": "^3.2.4",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.3",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "eslint-plugin-storybook": "^9.1.2",
    "globals": "^15.14.0",
    "jest": "^29.7.0",
    "jsdom": "^26.1.0",
    "playwright": "^1.54.1",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "start-server-and-test": "^2.0.13",
    "storybook": "^9.1.2",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.35.1",
    "vite": "^7.0.4",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/apps/",
      "<rootDir>/libs/"
    ],
    "testPathIgnorePatterns": [
      "<rootDir>/apps/dashboard/"
    ],
    "moduleNameMapper": {
      "^@queuetie/event(|/.*)$": "<rootDir>/libs/event/src/$1",
      "^@queuetie/pino(|/.*)$": "<rootDir>/libs/pino/src/$1",
      "^@queuetie/bullmq(|/.*)$": "<rootDir>/libs/bullmq/src/$1",
      "^@queuetie/redis(|/.*)$": "<rootDir>/libs/redis/src/$1",
      "^@queuetie/types(|/.*)$": "<rootDir>/libs/types/src/$1",
      "^@queuetie/config(|/.*)$": "<rootDir>/libs/config/src/$1"
    },
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.ts"
    ]
  }
}
