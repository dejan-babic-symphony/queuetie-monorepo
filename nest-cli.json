{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/queuetie-monorepo/src",
  "defaultLibraryPrefix": "@queuetie",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": false,
    "tsConfigPath": "apps/queuetie-monorepo/tsconfig.app.json",
    "plugins": [
      {
        "name": "@nestjs/swagger",
        "options": {
          "classValidatorShim": true,
          "introspectComments": true
        }
      }
    ]
  },
  "monorepo": true,
  "root": "apps/queuetie-monorepo",
  "projects": {
    "queuetie-monorepo": {
      "type": "application",
      "root": "apps/queuetie-monorepo",
      "entryFile": "main",
      "sourceRoot": "apps/queuetie-monorepo/src",
      "compilerOptions": {
        "tsConfigPath": "apps/queuetie-monorepo/tsconfig.app.json"
      }
    },
    "gateway": {
      "type": "application",
      "root": "apps/gateway",
      "entryFile": "main",
      "sourceRoot": "apps/gateway/src",
      "compilerOptions": {
        "tsConfigPath": "apps/gateway/tsconfig.app.json"
      }
    },
    "dispatcher": {
      "type": "application",
      "root": "apps/dispatcher",
      "entryFile": "main",
      "sourceRoot": "apps/dispatcher/src",
      "compilerOptions": {
        "tsConfigPath": "apps/dispatcher/tsconfig.app.json"
      }
    },
    "worker": {
      "type": "application",
      "root": "apps/worker",
      "entryFile": "main",
      "sourceRoot": "apps/worker/src",
      "compilerOptions": {
        "tsConfigPath": "apps/worker/tsconfig.app.json"
      }
    },
    "event": {
      "type": "library",
      "root": "libs/event",
      "entryFile": "index",
      "sourceRoot": "libs/event/src",
      "compilerOptions": {
        "tsConfigPath": "libs/event/tsconfig.lib.json"
      }
    },
    "pino": {
      "type": "library",
      "root": "libs/pino",
      "entryFile": "index",
      "sourceRoot": "libs/pino/src",
      "compilerOptions": {
        "tsConfigPath": "libs/pino/tsconfig.lib.json"
      }
    },
    "bullmq": {
      "type": "library",
      "root": "libs/bullmq",
      "entryFile": "index",
      "sourceRoot": "libs/bullmq/src",
      "compilerOptions": {
        "tsConfigPath": "libs/bullmq/tsconfig.lib.json"
      }
    },
    "redis": {
      "type": "library",
      "root": "libs/redis",
      "entryFile": "index",
      "sourceRoot": "libs/redis/src",
      "compilerOptions": {
        "tsConfigPath": "libs/redis/tsconfig.lib.json"
      }
    },
    "types": {
      "type": "library",
      "root": "libs/types",
      "entryFile": "index",
      "sourceRoot": "libs/types/src",
      "compilerOptions": {
        "tsConfigPath": "libs/types/tsconfig.lib.json"
      }
    },
    "config": {
      "type": "library",
      "root": "libs/config",
      "entryFile": "index",
      "sourceRoot": "libs/config/src",
      "compilerOptions": {
        "tsConfigPath": "libs/config/tsconfig.lib.json"
      }
    }
  }
}
